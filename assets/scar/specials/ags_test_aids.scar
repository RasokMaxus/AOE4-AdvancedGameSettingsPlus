---------------------------------------------------------------------------------------------------
-- TEMPORARY test aids. Remove this file and its import in ags_cardinal.scar when done.
--
-- 1. Depleted Mines: every gold/stone deposit starts just above the depletion threshold.
-- 2. Colour slots: the first player cycles through colour slots 9..16 to see which exist.
---------------------------------------------------------------------------------------------------

AGS_TEST_AIDS_MODULE = "AGS_TestAids"
AGS_TEST_DEPLETED_MINES = true
AGS_TEST_DEPLETED_START_AMOUNT = 210
AGS_TEST_COLOUR_SLOTS = false
AGS_TEST_COLOUR_FIRST = 9
AGS_TEST_COLOUR_LAST = 16
AGS_TEST_COLOUR_INTERVAL = 8

AGS_TEST_AIDS_STATE = { slot = nil, message = nil }

Core_RegisterModule(AGS_TEST_AIDS_MODULE)

function AGS_TestAids_OnStarting()
	if AGS_TEST_DEPLETED_MINES then
		AGS_TestAids_LowerDeposits()
	end
	if AGS_TEST_COLOUR_SLOTS then
		AGS_TEST_AIDS_STATE.slot = AGS_TEST_COLOUR_FIRST - 1
		Rule_AddInterval(AGS_TestAids_NextColour, AGS_TEST_COLOUR_INTERVAL)
	end
end

function AGS_TestAids_Message(text)
	local state = AGS_TEST_AIDS_STATE
	if state.message ~= nil then
		UI_SystemMessageHide(state.message)
	end
	state.message = text
	if text ~= nil then
		UI_SystemMessageShow(text)
	end
end

function AGS_TestAids_LowerDeposits()
	local eg = EGroup_CreateIfNotFound("eg_ags_test_aids_deposits")
	EGroup_Clear(eg)
	World_GetAllNeutralEntities(eg)
	for i = 1, EGroup_Count(eg) do
		local entity = EGroup_GetEntityAt(eg, i)
		if (Entity_IsOfType(entity, AGS_BP_DEPOSIT_GOLD) or Entity_IsOfType(entity, AGS_BP_DEPOSIT_STONE))
		and Entity_GetRemainingResourceDepositAmount(entity) > AGS_TEST_DEPLETED_START_AMOUNT then
			Entity_SetRemainingResourceDepositAmount(entity, AGS_TEST_DEPLETED_START_AMOUNT)
		end
	end
	EGroup_Clear(eg)
end

function AGS_TestAids_NextColour()
	local state = AGS_TEST_AIDS_STATE
	local player = PLAYERS[1]
	if player == nil then
		Rule_RemoveMe()
		return
	end
	state.slot = state.slot + 1
	if state.slot > AGS_TEST_COLOUR_LAST then
		Game_SetPlayerColour(player.id, 1)
		AGS_TestAids_Message(nil)
		Rule_RemoveMe()
		return
	end
	local ok = pcall(Game_SetPlayerColour, player.id, state.slot)
	if ok then
		AGS_TestAids_Message("Colour test: slot "..state.slot)
	else
		AGS_TestAids_Message("Colour test: slot "..state.slot.." rejected")
	end
end
